# ─── Stage 1: Composer dependencies ──────────────────────────────────────────────
FROM php:8.4-cli AS composer_stage
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer
RUN apt-get update && apt-get install -y git zip unzip
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader

# ─── Stage 2: Production image ───────────────────────────────────────────────
FROM php:8.4-cli

# System dependencies
RUN apt-get update && apt-get install -y \
    libpng-dev \
    libzip-dev \
    zip \
    unzip \
    git \
    curl \
    && docker-php-ext-install pdo_mysql zip gd \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/backend

# Copy app files
COPY . .
COPY --from=composer_stage /app/vendor ./vendor

# Laravel setup
RUN mkdir -p storage/framework/cache/data \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache

RUN chmod -R 777 storage bootstrap/cache

RUN php artisan config:clear || true \
    && php artisan route:clear || true \
    && php artisan view:clear || true

# Run migrations + serve
EXPOSE 8080
ENV PHP_CLI_SERVER_WORKERS=8
CMD ["sh", "-c", "cat /secrets/.env > /var/www/backend/.env && echo \"\nDB_SOCKET=${DB_SOCKET}\" >> /var/www/backend/.env && php artisan migrate --force && php -S 0.0.0.0:${PORT:-8080} -t public/"]
