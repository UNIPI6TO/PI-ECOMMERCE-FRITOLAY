# === DESARROLLO LOCAL — docker-compose ===
# Copia este archivo como .env en el directorio raíz

# ─── Base de Datos ──────────────────────────────────────────────
DB_DATABASE=fritolay_db
DB_USERNAME=fritolay
DB_PASSWORD=dev_password_change_me
MYSQL_ROOT_PASSWORD=root_dev_change_me

# ─── JWT ────────────────────────────────────────────────────────
# NUNCA uses este valor en producción. En producción: GCP Secret Manager
JWT_SECRET=dev_jwt_secret_change_in_production_minimum_32_chars
JWT_EXPIRY_MINUTES=60

# ─── Google Cloud Storage ───────────────────────────────────────
GCS_BUCKET_IMAGENES=fritolay-imagenes-dev
GCS_BUCKET_COMPROBANTES=fritolay-comprobantes-dev
GCS_IMAGE_CACHE_HOURS=4

# ─── Firebase / Firestore ───────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=/var/www/backend/storage/firebase-credentials.json

# ─── GPS ────────────────────────────────────────────────────────
GPS_UPDATE_INTERVAL_SECONDS=5

# ─── Email (Gmail SMTP) ─────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@fritolay.com
MAIL_FROM_NAME="Fritolay Ambato"

# ─── Negocio ────────────────────────────────────────────────────
PIN_DIGITS=6
IVA_PORCENTAJE=15
STOCK_ALERT_THRESHOLD_PERCENT=10
